<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record model="ir.ui.view" id="view_df_learning_record_batch_modify_form">
            <field name="name">df.learning.record.batch.modify.wizard.form</field>
            <field name="model">df.learning.record.batch.modify.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="plan_done_date"/>
                            <field name="actual_done_date"/>
                            <field name="description"/>
                        </group>
                    </sheet>
                    <footer>
                        <button name="button_ok" string="确定" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x" />
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>